{
  "name": "gvozdla",
  "version": "0.1.0",
  "description": "Create projects from Git templates and merge selected template updates safely.",
  "homepage": "https://github.com/nail00749/template#readme",
  "bugs": {
    "url": "https://github.com/nail00749/template/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nail00749/template.git"
  },
  "bin": {
    "create-tanstack": "./scaffold/cli.ts",
    "gvozdla": "./scaffold/gvozdla/cli.ts"
  },
  "files": [
    "scaffold/cli.ts",
    "scaffold/core.ts",
    "scaffold/gvozdla/cli.ts",
    "scaffold/gvozdla/manifest.ts",
    "scaffold/gvozdla/state.ts",
    "scaffold/gvozdla/sync.ts",
    "template.manifest.json",
    "docs/gvozdla-architecture.md",
    "docs/gvozdla-guide.md",
    "docs/gvozdla-agents.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "gvozdla": "bun ./scaffold/gvozdla/cli.ts",
    "create": "bun ./scaffold/cli.ts",
    "test": "bun test ./scaffold/core.test.ts ./scaffold/cli.test.ts ./scaffold/gvozdla ./scaffold/features/keycloak-auth/overlay/src/shared/auth/post-login-redirect.test.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
