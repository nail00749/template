{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "singleAttributePerLine": true,
  "bracketSameLine": false,
  "ignorePatterns": [
    ".output/",
    "dist/",
    "node_modules/",
    "bun.lock",
    "src/routeTree.gen.ts",
    "src/features/*/api/endpoints/",
    "src/features/*/api/model/"
  ]
}
