{
  "name": "proback-frontend-legal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests && bun test scripts/braces-security.test.ts scripts/deepmerge-security.test.ts",
    "lint": "oxlint",
    "format": "oxfmt .",
    "check": "oxfmt --check . && oxlint && bun run check:architecture && bun run check:skills && bun run i18n:check",
    "fix": "oxfmt --write . && oxlint --fix",
    "i18n:build": "intlayer build",
    "i18n:check": "bun run i18n:build && intlayer test",
    "typecheck": "bun run i18n:build && tsc --noEmit",
    "generate-api": "bunx orval",
    "check:architecture": "bun scripts/check-architecture.ts",
    "check:skills": "bun scripts/check-skills.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/router-plugin": "^1.168.45",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "intlayer": "^9.7.0",
    "lucide-react": "^1.57.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-intlayer": "^9.7.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@shadcn/lint": "^0.2.1",
    "@svgr/cli": "^8.1.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "braces": "file:vendor/braces",
    "deepmerge": "file:vendor/deepmerge",
    "jsdom": "^30.1.2",
    "orval": "^8.42.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "shadcn": "^4.22.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-intlayer": "^9.7.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@intlayer/backend-contract": {
      "zod": "4.6.7"
    },
    "@intlayer/config": {
      "zod": "4.6.7"
    },
    "@scalar/json-magic": {
      "undici": "7.30.1"
    },
    "braces": "$braces",
    "deepmerge": "$deepmerge",
    "js-yaml": "4.3.2",
    "qs": "6.17.0"
  },
  "packageManager": "bun@1.4.3"
}
